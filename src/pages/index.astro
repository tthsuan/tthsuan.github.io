---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';

const featuredPublications = (await getCollection('publications'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <div>
        <p class="eyebrow">Conservation researcher · Spatial ecologist</p>
        <h1>Tz-Hsuan <span>Tseng</span></h1>
      </div>
      <div class="hero-summary">
        <span class="index-mark">01</span>
        <p>I study how biodiversity information can guide conservation decisions across scales—from global prioritization and protected-area performance to urban habitats and field-based practice.</p>
      </div>
    </div>
    <div class="hero-visual">
      <PhotoPlaceholder label="A landscape for biodiversity" detail="Replace with a personal landscape photograph · 4:5 recommended" aspect="portrait" tone="forest" />
    </div>
  </section>

  <section class="section-shell home-intro">
    <div>
      <p class="eyebrow">About</p>
      <h2>From patterns on the map to outcomes on the ground.</h2>
    </div>
    <div>
      <p class="large-copy">I am a PhD candidate in Landscape Architecture at Tsinghua University and a Research Officer with the IUCN World Commission on Protected Areas. My work connects conservation planning, spatial biodiversity science, and practical questions of stewardship and livelihoods.</p>
      <a class="text-link" href="/cv/">Explore my background <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research questions</p>
        <h2>Where should conservation act—and how do we know it works?</h2>
      </div>
      <p>Four connected lines of inquiry organize my current and past work.</p>
    </div>
    <div class="research-grid">
      <article class="research-card">
        <span class="research-number">01</span>
        <h3>Protected-area effectiveness</h3>
        <p>Evaluating how individual protected areas contribute to species habitat conservation, representation, and connectivity.</p>
      </article>
      <article class="research-card">
        <span class="research-number">02</span>
        <h3>Conservation prioritization</h3>
        <p>Examining the assumptions, hidden trade-offs, and decision consequences within quantitative priority-setting models.</p>
      </article>
      <article class="research-card">
        <span class="research-number">03</span>
        <h3>Spatial biodiversity analysis</h3>
        <p>Combining species distributions, environmental data, and spatial models to support conservation decisions across scales.</p>
      </article>
      <article class="research-card">
        <span class="research-number">04</span>
        <h3>People, cities, and practice</h3>
        <p>Studying urban biodiversity and connecting field evidence with community livelihoods, management, and implementation.</p>
      </article>
    </div>
    <a class="text-link" href="/research/">Read about the research <span aria-hidden="true">→</span></a>
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected publications</p>
        <h2>Recent work</h2>
      </div>
      <a class="text-link" href="/publications/">All publications <span aria-hidden="true">→</span></a>
    </div>
    <div class="publication-list">
      {featuredPublications.map(({ data }) => (
        <article class="publication-row">
          <span>{data.year}</span>
          <div>
            <h3>{data.title}</h3>
            <p>{data.journal} · {data.authors}</p>
          </div>
          {data.doi && <a class="publication-link" href={data.doi}>View paper ↗</a>}
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Outside the paper</p>
        <h2>Field notes, birds, and the places that shape the work.</h2>
      </div>
      <p>A growing space for personal photography, observations, and smaller projects.</p>
    </div>
    <PhotoPlaceholder label="Birds and working landscapes" detail="Replace with a personal bird or fieldwork photograph · 16:7 recommended" aspect="wide" tone="sky" />
    <a class="text-link" href="/photography/">Visit photography <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
